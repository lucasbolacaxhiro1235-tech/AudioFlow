# ============================================================
# AudioFlow — configuração de ambiente (nível do docker-compose)
# Copie para .env e preencha. Nunca commit .env.
# ============================================================

# --- Postgres ---
POSTGRES_USER=audioflow
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=audioflow

# --- Backend (sobrescreve valores do .env do backend) ---
DATABASE_URL=postgresql+asyncpg://audioflow:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/audioflow
REDIS_URL=redis://redis:6379/0

JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING_64_CHARS
FRONTEND_URL=https://audioflow.com
API_BASE_URL=https://api.audioflow.com
CORS_ORIGINS=https://audioflow.com,https://www.audioflow.com

# --- Storage: local | s3 | r2 ---
STORAGE_BACKEND=local
STORAGE_PUBLIC_BASE_URL=https://api.audioflow.com/media

# S3 / Cloudflare R2 (quando STORAGE_BACKEND=s3 ou r2)
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=audioflow
S3_PUBLIC_URL=
S3_REGION=auto

# --- Email / SMTP ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@audioflow.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# --- Audio processing ---
MAX_CONCURRENT_DOWNLOADS=4

# --- Acesso anônimo (sem login). true = site aberto ao público ---
ALLOW_ANONYMOUS=true

# --- Primeiro administrador (criado no primeiro boot) ---
FIRST_ADMIN_EMAIL=admin@audioflow.com
FIRST_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD