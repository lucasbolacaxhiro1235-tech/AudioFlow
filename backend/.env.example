# ============================================================
# AudioFlow — Environment configuration
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# --- Core ---
APP_NAME=AudioFlow
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=https://audioflow.com
API_BASE_URL=https://api.audioflow.com
# Comma-separated extra origins allowed by CORS
CORS_ORIGINS=https://audioflow.com,https://www.audioflow.com

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://audioflow:CHANGE_ME@postgres:5432/audioflow

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- JWT ---
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING_64_CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Storage: local | s3 | r2 ---
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
# Public base URL used to serve local files
STORAGE_PUBLIC_BASE_URL=https://api.audioflow.com/media

# --- S3 / Cloudflare R2 (when STORAGE_BACKEND=s3 or r2) ---
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=audioflow
S3_PUBLIC_URL=
S3_REGION=auto

# --- Email / SMTP ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@audioflow.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# --- Audio processing ---
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
AUDIO_OUTPUT_FORMAT=mp3
AUDIO_QUALITY=192k
MAX_CONCURRENT_DOWNLOADS=4
MAX_DOWNLOAD_FILE_SIZE_MB=200

# --- Rate limiting ---
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW=60
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW=60

# --- Bootstrapping (create the first admin on startup) ---
FIRST_ADMIN_EMAIL=admin@audioflow.com
FIRST_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
SEED_PLANS=true